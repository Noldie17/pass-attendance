{
  "name": "pass-attendance",
  "version": "0.1.0",
  "private": true,
  "description": "Offline attendance scanning system for Pantabangan National High School",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
