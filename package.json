  "dependencies": {
    "@fontsource/inter": "5.2.5",
    "exceljs": "4.4.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.0.9",
    "@types/node": "22.13.10",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "35.1.5",
    "electron-builder": "26.0.12",
    "electron-vite": "3.0.0",
    "tailwindcss": "4.0.9",
    "typescript": "5.8.2",
    "vite": "6.2.2",
    "vitest": "3.0.8"
